<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="AppBackground"     Color="#EEF0FF"/>
    <SolidColorBrush x:Key="CardBackground"    Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SurfaceBackground" Color="#F5F6FF"/>
    <SolidColorBrush x:Key="AccentPrimary"     Color="#6C63FF"/>
    <SolidColorBrush x:Key="AccentSecondary"   Color="#7C74FF"/>
    <SolidColorBrush x:Key="TextPrimary"       Color="#1A1B2E"/>
    <SolidColorBrush x:Key="TextSecondary"     Color="#6B6B8D"/>
    <SolidColorBrush x:Key="BorderBrush"       Color="#D8D8F0"/>
    <SolidColorBrush x:Key="SuccessColor"      Color="#16A34A"/>
    <SolidColorBrush x:Key="ErrorColor"        Color="#DC2626"/>
    <SolidColorBrush x:Key="InputBackground"   Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ToggleTrack"       Color="#D8D8F0"/>

    <Color x:Key="SuccessColorRaw"             >#16A34A</Color>
    <Color x:Key="ErrorColorRaw"               >#DC2626</Color>
    <Color x:Key="AccentPrimaryRaw"            >#6C63FF</Color>

</ResourceDictionary>
