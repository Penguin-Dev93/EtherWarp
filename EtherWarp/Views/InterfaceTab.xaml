<UserControl x:Class="EtherWarp.Views.InterfaceTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:EtherWarp.Converters">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <conv:BoolToVisibilityConverter x:Key="InvBoolToVis" Invert="True"/>
        <conv:StringToVisibilityConverter x:Key="StrToVis"/>
        <conv:NullToVisibilityConverter x:Key="NullToVis"/>
        <conv:NullToBoolConverter x:Key="NullToBool"/>
        <conv:NullToBoolConverter x:Key="InvNullToBool" Invert="True"/>
    </UserControl.Resources>

    <Grid>
        <Border Style="{StaticResource CardBorder}"
                MaxWidth="480"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="12,0,12,12">

            <StackPanel>

                <!-- Header -->
                <TextBlock Text="Apply Configuration"
                           Foreground="{DynamicResource TextPrimary}"
                           FontSize="20" FontWeight="Bold"
                           Margin="0,0,0,6"/>
                <TextBlock Text="Select a preset and apply it to the target adapter."
                           Foreground="{DynamicResource TextSecondary}"
                           FontSize="13"
                           Margin="0,0,0,16"/>

                <!-- Adapter selector -->
                <TextBlock Text="Target Adapter" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                <ComboBox x:Name="AdapterComboBox"
                          ItemsSource="{Binding InterfaceVM.AvailableAdapters}"
                          SelectedItem="{Binding InterfaceVM.SelectedAdapterName, Mode=OneWay}"
                          SelectionChanged="AdapterComboBox_SelectionChanged"
                          Style="{StaticResource ComboBoxStyle}"
                          Margin="0,0,0,16"/>

                <!-- Separator -->
                <Border Height="1"
                        Background="{DynamicResource BorderBrush}"
                        Margin="0,0,0,16"/>

                <!-- Preset selector -->
                <TextBlock Text="Select Preset" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                <ComboBox ItemsSource="{Binding InterfaceVM.AvailablePresets}"
                          SelectedItem="{Binding InterfaceVM.SelectedPreset, Mode=TwoWay}"
                          Style="{StaticResource ComboBoxStyle}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <!-- Selected preset info card -->
                <Border Margin="0,12,0,0"
                        CornerRadius="10"
                        Background="{DynamicResource SurfaceBackground}"
                        Padding="14,10"
                        Visibility="{Binding InterfaceVM.SelectedPreset, Converter={StaticResource NullToVis}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0"
                                   Text="Adapter:"
                                   Foreground="{DynamicResource TextSecondary}"
                                   FontSize="12" Margin="0,0,12,4"/>
                        <TextBlock Grid.Row="0" Grid.Column="1"
                                   Text="{Binding InterfaceVM.SelectedAdapterName}"
                                   Foreground="{DynamicResource TextPrimary}"
                                   FontSize="12" Margin="0,0,0,4"/>

                        <TextBlock Grid.Row="1" Grid.Column="0"
                                   Text="Target IP:"
                                   Foreground="{DynamicResource TextSecondary}"
                                   FontSize="12" Margin="0,0,12,4"/>
                        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="{Binding InterfaceVM.SelectedPreset.IPAddress}"
                                       Foreground="{DynamicResource TextPrimary}" FontSize="12"/>
                            <TextBlock Text=" / " Foreground="{DynamicResource TextSecondary}" FontSize="12"/>
                            <TextBlock Text="{Binding InterfaceVM.SelectedPreset.SubnetMask}"
                                       Foreground="{DynamicResource TextPrimary}" FontSize="12"/>
                        </StackPanel>

                        <TextBlock Grid.Row="2" Grid.Column="0"
                                   Text="Gateway:"
                                   Foreground="{DynamicResource TextSecondary}"
                                   FontSize="12" Margin="0,0,12,4"/>
                        <TextBlock Grid.Row="2" Grid.Column="1"
                                   Text="{Binding InterfaceVM.SelectedPreset.Gateway, TargetNullValue='—', FallbackValue='—'}"
                                   Foreground="{DynamicResource TextPrimary}"
                                   FontSize="12" Margin="0,0,0,4"/>

                        <TextBlock Grid.Row="3" Grid.Column="0"
                                   Text="DNS:"
                                   Foreground="{DynamicResource TextSecondary}"
                                   FontSize="12" Margin="0,0,12,0"/>
                        <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal">
                            <TextBlock Text="{Binding InterfaceVM.SelectedPreset.PrimaryDNS, TargetNullValue='—', FallbackValue='—'}"
                                       Foreground="{DynamicResource TextPrimary}" FontSize="12"/>
                            <TextBlock Text=", "
                                       Foreground="{DynamicResource TextSecondary}"
                                       FontSize="12"
                                       Visibility="{Binding InterfaceVM.SelectedPreset.SecondaryDNS, Converter={StaticResource StrToVis}}"/>
                            <TextBlock Text="{Binding InterfaceVM.SelectedPreset.SecondaryDNS}"
                                       Foreground="{DynamicResource TextPrimary}"
                                       FontSize="12"
                                       Visibility="{Binding InterfaceVM.SelectedPreset.SecondaryDNS, Converter={StaticResource StrToVis}}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Action Buttons -->
                <Button Content="▶  Execute"
                        Command="{Binding InterfaceVM.ExecutePresetCommand}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        Margin="0,16,0,0"/>
                <Button Content="↺  Reset to DHCP"
                        Command="{Binding InterfaceVM.ResetToDHCPCommand}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        Margin="0,8,0,0"/>

                <!-- Busy indicator -->
                <StackPanel Orientation="Horizontal"
                            Margin="0,12,0,0"
                            Visibility="{Binding InterfaceVM.IsBusy, Converter={StaticResource BoolToVis}}">
                    <ProgressBar IsIndeterminate="True"
                                 Width="120" Height="3"
                                 Margin="0,0,10,0"
                                 VerticalAlignment="Center"/>
                    <TextBlock Text="Applying configuration..."
                               Foreground="{DynamicResource TextSecondary}"
                               FontSize="12"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Status card -->
                <Border Margin="0,12,0,0"
                        Visibility="{Binding InterfaceVM.StatusMessage, Converter={StaticResource StrToVis}}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius"    Value="10"/>
                            <Setter Property="Padding"         Value="14,10"/>
                            <Setter Property="BorderThickness" Value="1"/>
                            <Setter Property="BorderBrush"     Value="{DynamicResource SuccessColor}"/>
                            <Setter Property="Background">
                                <Setter.Value>
                                    <SolidColorBrush Color="#4ADE80" Opacity="0.15"/>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding InterfaceVM.StatusIsSuccess}" Value="False">
                                    <Setter Property="BorderBrush"     Value="{DynamicResource ErrorColor}"/>
                                    <Setter Property="Background">
                                        <Setter.Value>
                                            <SolidColorBrush Color="#FF6B6B" Opacity="0.15"/>
                                        </Setter.Value>
                                    </Setter>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding InterfaceVM.StatusMessage}"
                               Foreground="{DynamicResource TextPrimary}"
                               FontSize="12"
                               TextWrapping="Wrap"/>
                </Border>

            </StackPanel>
        </Border>
    </Grid>
</UserControl>
