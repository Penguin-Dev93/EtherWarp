<Window x:Class="EtherWarp.Views.TrayQuickWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource WindowStyle}"
        Width="360"
        Height="430"
        MinWidth="360"
        MinHeight="430"
        MaxWidth="360"
        MaxHeight="430"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        ShowInTaskbar="False"
        Topmost="True"
        Background="Transparent"
        Deactivated="Window_Deactivated">

    <Border Background="{DynamicResource AppBackground}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="14"
            Padding="16">
        <Border.Effect>
            <DropShadowEffect Color="#000000"
                              BlurRadius="24"
                              ShadowDepth="4"
                              Opacity="0.28"
                              Direction="270"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="EtherWarp"
                               Foreground="{DynamicResource AccentPrimary}"
                               FontWeight="Bold"
                               FontSize="18"/>
                    <TextBlock Text="Quick network controls"
                               Foreground="{DynamicResource TextSecondary}"
                               FontSize="12"
                               Margin="0,2,0,0"/>
                </StackPanel>

                <Button Grid.Column="1"
                        Content="Open"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Padding="12,7"
                        Click="OpenButton_Click"/>
            </Grid>

            <StackPanel Grid.Row="1" Margin="0,0,0,12">
                <TextBlock Text="Adapter" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                <ComboBox x:Name="AdapterComboBox"
                          Style="{StaticResource ComboBoxStyle}"
                          SelectionChanged="AdapterComboBox_SelectionChanged"/>
            </StackPanel>

            <Grid Grid.Row="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="Preset"
                           Style="{StaticResource FieldLabel}"
                           Margin="0,0,0,4"/>

                <Border Grid.Row="1"
                        Background="{DynamicResource CardBackground}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="6">
                    <ListBox x:Name="PresetListBox"
                             Foreground="{DynamicResource TextPrimary}"
                             SelectionChanged="PresetListBox_SelectionChanged"/>
                </Border>
            </Grid>

            <Grid Grid.Row="3" Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="ApplyButton"
                        Grid.Column="0"
                        Content="Apply"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Click="ApplyButton_Click"/>

                <Button x:Name="DhcpButton"
                        Grid.Column="2"
                        Content="DHCP"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="DhcpButton_Click"/>
            </Grid>

            <Border x:Name="StatusBorder"
                    Grid.Row="4"
                    Background="{DynamicResource SurfaceBackground}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="10,8"
                    Margin="0,12,0,0">
                <TextBlock x:Name="StatusTextBlock"
                           Text="Ready"
                           Foreground="{DynamicResource TextSecondary}"
                           FontSize="12"
                           TextWrapping="Wrap"
                           MaxHeight="52"/>
            </Border>
        </Grid>
    </Border>
</Window>
